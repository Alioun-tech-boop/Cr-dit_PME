# Identifiants exclusivement locaux et synthétiques ; ne pas réutiliser en production.
DATABASE_URL=postgresql+psycopg://credit:credit_local@localhost:5432/credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit_local
POSTGRES_DB=credit

# Lancement Python uniquement, export requis (Compose monte son fichier séparément) :
# CREDIT_AUTH_FILE=/workspace/.local/auth/users.json

# Uniquement dossiers synthétiques ; politique illustrative non validée.
CREDIT_ALLOW_DEMO=false

# Éditions imprimables : ressources exclusivement configurées côté serveur.
CREDIT_PRINT_PLATFORM_NAME=Crédit PME
CREDIT_PRINT_LOGO_FILE=
CREDIT_PRINT_TIMEOUT_SECONDS=30
CREDIT_PRINT_CONCURRENCY=2
CREDIT_PRINT_MAX_PAGES=120
CREDIT_PRINT_MAX_INPUT_BYTES=3000000
CREDIT_PRINT_MAX_OUTPUT_BYTES=15000000
CREDIT_PRINT_MEMORY_MB=512

# Sécurité locale ; ces limites sont par processus API.
CREDIT_ENV=local
CREDIT_ALLOWED_HOSTS=localhost,127.0.0.1
CREDIT_RATE_REQUESTS=600
CREDIT_RATE_ACTOR=600
CREDIT_RATE_JOBS=120
CREDIT_RATE_AUTH_FAILURES=40
CREDIT_MAX_JSON_BYTES=2000000
CREDIT_BODY_TIMEOUT_SECONDS=20
CREDIT_MAX_CASES_PER_ACTOR=1000
CREDIT_MAX_DOCUMENTS_PER_CASE=500
CREDIT_ANTIMALWARE_REQUIRED=false
CREDIT_TRUSTED_PROXY_IPS=127.0.0.1

# Passerelle navigateur ; ouvrir exactement cette origine (cookies et CSRF).
CREDIT_WEB_ORIGIN=http://127.0.0.1:8000
CREDIT_ASGI_APP=credit.web.application:app
# En production : origine HTTPS obligatoire, cookie Secure automatiquement.
# Aucun jeton Bearer technique n'est configuré dans frontend/dist/runtime-config.js.

# Attente maximale d’un créneau OCR/aperçu, bornée à 5 secondes.
CREDIT_SCAN_QUEUE_WAIT_SECONDS=5

# Moteur déterministe v2 ; fichiers de politiques approuvées administrés hors API.
# CREDIT_FINANCIAL_V2_POLICIES_DIR=/chemin/prive/politiques-v2
# Budget de travail : périodes × (scénarios + recherches + variantes), pas un seuil bancaire.
CREDIT_FINANCIAL_V2_MAX_WORK=50000

# Transmission bancaire : aucune banque ou clé n’est créée au démarrage.
CREDIT_PARTNER_ALLOW_DEMO=false
# CREDIT_PARTNER_KEYRING_FILE=/run/secrets/credit-partner-keyring.json
CREDIT_PARTNER_MAX_PACKET_BYTES=50000000
CREDIT_PARTNER_EXPORTS_PER_MINUTE=30
CREDIT_PARTNER_RETRY_BASE_SECONDS=15
# Webhooks : référence administrée dans le partenaire, secret fourni hors dépôt.
# CREDIT_PARTNER_WEBHOOK_BANK_ID=<secret fourni par l’opérateur, jamais dans le frontend>

# Build Netlify uniquement : origine publique Render (aucun jeton).
# CREDIT_BACKEND_ORIGIN=https://<service>.onrender.com
# Render fournit PORT automatiquement ; valeur locale par défaut : 8000.
